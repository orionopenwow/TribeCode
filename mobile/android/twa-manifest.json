{
  "packageId": "org.tribecode.app",
  "host": "tribecode.org",
  "name": "TribeCode",
  "launcherName": "TribeCode",
  "display": "standalone",
  "orientation": "default",
  "themeColor": "#12151A",
  "themeColorDark": "#12151A",
  "navigationColor": "#12151A",
  "navigationColorDark": "#12151A",
  "navigationDividerColor": "#2A313C",
  "navigationDividerColorDark": "#2A313C",
  "backgroundColor": "#12151A",
  "enableNotifications": true,
  "startUrl": "/app/?source=twa",
  "iconUrl": "https://tribecode.org/app/assets/icon-512.png",
  "maskableIconUrl": "https://tribecode.org/app/assets/icon-512-maskable.png",
  "monochromeIconUrl": "https://tribecode.org/app/assets/icon-monochrome.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": { "path": "./android.keystore", "alias": "tribecode" },
  "appVersionName": "0.28.0",
  "appVersionCode": 1,
  "shortcuts": [
    { "name": "New note", "shortName": "Note", "url": "/app/?shortcut=note", "chosenIconUrl": "https://tribecode.org/app/assets/shortcuts/note.png" },
    { "name": "Ask Flint", "shortName": "Flint", "url": "/app/?shortcut=flint", "chosenIconUrl": "https://tribecode.org/app/assets/shortcuts/flint.png" },
    { "name": "Tasks", "shortName": "Tasks", "url": "/app/?shortcut=tasks", "chosenIconUrl": "https://tribecode.org/app/assets/shortcuts/tasks.png" },
    { "name": "Chat", "shortName": "Chat", "url": "/app/?shortcut=chat", "chosenIconUrl": "https://tribecode.org/app/assets/shortcuts/chat.png" }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://tribecode.org/app/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {},
  "alphaDependencies": { "enabled": false },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://tribecode.org/app/",
  "minSdkVersion": 21,
  "targetSdkVersion": 36,
  "orientationLock": false,
  "shareTarget": {
    "action": "/app/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "files", "accept": ["image/*", "text/*", "application/json", "model/gltf-binary"] }] }
  },
  "protocolHandlers": [{ "protocol": "web+tribecode", "url": "/app/?protocol=%s" }],
  "fileHandlers": [{ "actionUrl": "/app/?open-file=1", "mimeTypes": ["text/markdown", "application/json", "model/gltf-binary", "image/png"] }],
  "additionalTrustedOrigins": [],
  "retainedBundles": [],
  "appVersion": "0.28.0"
}
