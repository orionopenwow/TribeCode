{ "id": "auth", "title": "Sign in screen", "keys": ["log ?in", "sign ?in", "sign ?up", "register", "auth", "create (an )?account"], "size": [390, 844], "accent": "#2F6FEB",
  "root": { "n": "{{name}} · Sign in", "lay": "col 28 72,28,32,28 stretch start", "k": [
    { "n": "Brand", "lay": "row 10 0 center start", "sz": "fill", "k": [
      { "t": "rect", "n": "Logo", "w": 36, "h": 36, "r": 10, "fill": "{{accent}}" },
      { "t": "text", "n": "Brand name", "c": "{{name}}", "s": 18, "wt": 700 } ] },
    { "n": "Heading", "lay": "col 8 0 start start", "sz": "fill", "k": [
      { "t": "text", "n": "Title", "c": "Welcome back", "s": 30, "wt": 700, "f": "Inter Display" },
      { "t": "text", "n": "Subtitle", "c": "Sign in to pick up where you left off.", "s": 15, "col": "{{muted}}", "sz": "fill" } ] },
    { "n": "Form", "lay": "col 14 0 stretch start", "sz": "fill", "k": [
      { "n": "Email field", "lay": "col 6 0 stretch start", "sz": "fill", "k": [
        { "t": "text", "n": "Email label", "c": "Email", "s": 13, "wt": 600 },
        { "n": "Email input", "fill": "{{surface}}", "stroke": "{{line}}", "r": 10, "lay": "row 8 14,14 center start", "sz": "fill", "k": [
          { "t": "text", "n": "Email placeholder", "c": "you@example.com", "s": 15, "col": "{{muted}}" } ] } ] },
      { "n": "Password field", "lay": "col 6 0 stretch start", "sz": "fill", "k": [
        { "n": "Password label row", "lay": "row 8 0 center between", "sz": "fill", "k": [
          { "t": "text", "n": "Password label", "c": "Password", "s": 13, "wt": 600 },
          { "t": "text", "n": "Forgot link", "c": "Forgot password?", "s": 13, "wt": 600, "col": "{{accent}}" } ] },
        { "n": "Password input", "fill": "{{surface}}", "stroke": "{{line}}", "r": 10, "lay": "row 8 14,14 center start", "sz": "fill", "k": [
          { "t": "text", "n": "Password dots", "c": "••••••••••", "s": 15, "col": "{{muted}}" } ] } ] },
      { "n": "Sign in button", "fill": "{{accent}}", "r": 10, "lay": "row 8 15,20 center center", "sz": "fill", "k": [
        { "t": "text", "n": "Button label", "c": "Sign in", "s": 16, "wt": 600, "col": "{{onAccent}}" } ] } ] },
    { "n": "Divider", "lay": "row 12 0 center start", "sz": "fill", "k": [
      { "t": "rect", "n": "Line", "w": 120, "h": 1, "fill": "{{line}}", "sz": "fill fixed" },
      { "t": "text", "n": "Or", "c": "or", "s": 13, "col": "{{muted}}" },
      { "t": "rect", "n": "Line", "w": 120, "h": 1, "fill": "{{line}}", "sz": "fill fixed" } ] },
    { "n": "Magic link button", "stroke": "{{line}}", "r": 10, "lay": "row 8 14,20 center center", "sz": "fill", "k": [
      { "t": "text", "n": "Magic link label", "c": "Email me a sign-in link", "s": 15, "wt": 600 } ] },
    { "n": "Spacer", "h": 1, "sz": "fill fill" },
    { "t": "text", "n": "Create account", "c": "New to {{name}}? Create an account", "s": 14, "col": "{{muted}}", "al": "center", "sz": "fill" } ] } }
