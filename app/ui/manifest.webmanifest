{
  "id": "./",
  "name": "TribeCode",
  "short_name": "TribeCode",
  "description": "Code with friends. One link to join, one shared brain, one vision.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#12151A",
  "theme_color": "#12151A",
  "categories": ["developer", "productivity", "social"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icon-monochrome.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" },
    { "src": "assets/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "assets/screens/wide-1.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Chat with your tribe and your agents, tasks and preview side by side" },
    { "src": "assets/screens/narrow-1.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "The phone layout: chat, files, updates and tasks one thumb away" }
  ],
  "shortcuts": [
    { "name": "New note", "short_name": "Note", "description": "Start a note in your docs", "url": "./?shortcut=note", "icons": [{ "src": "assets/shortcuts/note.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Ask Flint", "short_name": "Flint", "description": "Ask TribeCode's built-in helper", "url": "./?shortcut=flint", "icons": [{ "src": "assets/shortcuts/flint.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Tasks", "short_name": "Tasks", "description": "Open the task board", "url": "./?shortcut=tasks", "icons": [{ "src": "assets/shortcuts/tasks.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Chat", "short_name": "Chat", "description": "Open the project chat", "url": "./?shortcut=chat", "icons": [{ "src": "assets/shortcuts/chat.png", "sizes": "96x96", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["image/*", "text/*", "application/json", "application/pdf", "model/gltf-binary", ".md", ".json", ".glb", ".gltf", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".txt"] }
      ]
    }
  },
  "file_handlers": [
    { "action": "./?open-file=1", "accept": { "text/markdown": [".md", ".markdown"], "application/json": [".json"], "model/gltf-binary": [".glb"], "image/png": [".png"] }, "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" }], "launch_type": "single-client" }
  ],
  "protocol_handlers": [
    { "protocol": "web+tribecode", "url": "./?protocol=%s" }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "handle_links": "preferred",
  "edge_side_panel": { "preferred_width": 420 }
}
